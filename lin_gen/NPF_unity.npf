/*** GENERAL DEFINITION ***/
LIN_node_config_file;

/*** MCU DEFINITION ***/
mcu {
   mcu_name                      = MC9S12ZVL32;
   bus_clock                     = 6250000;                  /* Frequency bus of system Hz*/
   xgate_support                 = no;                       /* Support XGATE Co-Processor */
}

/*** LIN HARDWARE DEFINITION ***/
/* Sci config */
sci {
   s12_sci0{
      sci_channel                = 0;
   }
}

/*** NETWORK DEFINITION ***/
network {
   idle_timeout                  = 5 s;
   time_period                   = 500 us;
   diagnostic_class              = 1;
   resynchronization_support     = no;
   autobaud_support              = no;
   max_message_length            = 6;
   LI0 {
      node                       = pNsystem;                 /* Name of node described in LDF (must check consistence with LDF) */
      file                       = "SeatPneumaticsystem_LINdbV1_8_8.ldf"; /* Name of LDF file */
      device                     = s12_sci0;
      support_sid {
         READ_BY_IDENTIFIER      = 0xb2;
         ASSIGN_FRAME_ID_RANGE   = 0xb7;
         SAVE_CONFIGURATION      = 0xb6;
      }
   }
}

